{
  "name": "backpack_core",
  "display_name": "Backpack Core",
  "icon": "icon.png",
  "version": "0.5.0",
  "type": "core",
  "interface": "universal",
  "category": "tools",
  "description": "Publishes Backpack app repos to Logos Storage: create a repo, add APKs or import an F-Droid repo, publish signed (optionally private, encrypted) indexes, verify, share the invite link. Same repos as the backpack CLI.",
  "main": "backpack_core_plugin",
  "dependencies": [
    "loam_core",
    "delivery_module"
  ],
  "nix": {
    "packages": {
      "build": [
        "openssl",
        "zlib"
      ],
      "runtime": [
        "openssl",
        "zlib"
      ]
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  }
}
